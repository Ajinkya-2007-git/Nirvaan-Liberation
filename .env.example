# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# These are secret-ish settings your app needs to connect to
# Supabase. They should NEVER be committed to a public GitHub
# repo with real values filled in — that's why this file is
# named ".env.example" (a template) instead of ".env" (the real
# one, which you'll create yourself and Git will ignore).
#
# HOW TO FILL THIS IN:
# 1. Go to your Supabase project dashboard
# 2. Click "Project Settings" -> "API"
# 3. Copy the "Project URL" and the "anon public" key
# ============================================================

# The web address of your specific Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# A public key that identifies your project. Despite being
# "public", real security still comes from the RLS policies
# we wrote in schema.sql — this key alone can't bypass them.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
